<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PowerAppsTargetsPath>$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\PowerApps</PowerAppsTargetsPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <Import Project="$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.props" Condition="Exists('$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.props')" />
  <PropertyGroup>
    <ProjectGuid>08987956-e3a7-46b9-a7a0-fda72fe16c69</ProjectGuid>
    <TargetFrameworkVersion>v4.6.2</TargetFrameworkVersion>
    <TargetFramework>net462</TargetFramework>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <SolutionRootPath>src</SolutionRootPath>
    <SolutionPackageType>Both</SolutionPackageType>
    <SolutionPackageEnableLocalization>false</SolutionPackageEnableLocalization>
    <TenantRoleCatalogueSource>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'tenant-role-catalogue', 'src', 'TenantRoleCatalogue.html'))</TenantRoleCatalogueSource>
    <TenantRoleCatalogueSuiteWebResource>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'src', 'WebResources', 'dht_', 'TenantRoleCatalogue.html'))</TenantRoleCatalogueSuiteWebResource>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.PowerApps.MSBuild.Solution" Version="1.*" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <ExcludeDirectories Include="$(MSBuildThisFileDirectory)\.gitignore" />
    <ExcludeDirectories Include="$(MSBuildThisFileDirectory)\bin\**" />
    <ExcludeDirectories Include="$(MSBuildThisFileDirectory)\obj\**" />
    <ExcludeDirectories Include="$(MSBuildThisFileDirectory)\*.cdsproj" />
    <ExcludeDirectories Include="$(MSBuildThisFileDirectory)\*.cdsproj.user" />
    <ExcludeDirectories Include="$(MSBuildThisFileDirectory)\*.sln" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)\**" Exclude="@(ExcludeDirectories)" />
    <Content Include="$(SolutionPackageZipFilePath)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="ValidateTenantRoleCatalogueWebResource" BeforeTargets="BeforeBuild" Inputs="$(TenantRoleCatalogueSource);$(TenantRoleCatalogueSuiteWebResource)" Outputs="$(BaseIntermediateOutputPath)TenantRoleCatalogueWebResource.validation">
    <GetFileHash Files="$(TenantRoleCatalogueSource)">
      <Output TaskParameter="Items" ItemName="TenantRoleCatalogueSourceHash" />
    </GetFileHash>
    <GetFileHash Files="$(TenantRoleCatalogueSuiteWebResource)">
      <Output TaskParameter="Items" ItemName="TenantRoleCatalogueSuiteHash" />
    </GetFileHash>
    <PropertyGroup>
      <TenantRoleCatalogueSourceFileHash>@(TenantRoleCatalogueSourceHash->'%(FileHash)')</TenantRoleCatalogueSourceFileHash>
      <TenantRoleCatalogueSuiteFileHash>@(TenantRoleCatalogueSuiteHash->'%(FileHash)')</TenantRoleCatalogueSuiteFileHash>
    </PropertyGroup>
    <Error Condition="'$(TenantRoleCatalogueSourceFileHash)' != '$(TenantRoleCatalogueSuiteFileHash)'" Text="Tenant Role Catalogue suite web resource is out of sync with the tool source. Copy tools/tenant-role-catalogue/src/TenantRoleCatalogue.html to tools/dataverse-html-tools-suite/solution/src/WebResources/dht_/TenantRoleCatalogue.html before building." />
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <Touch Files="$(BaseIntermediateOutputPath)TenantRoleCatalogueWebResource.validation" AlwaysCreate="true" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.Common.targets" />
  <Import Project="$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.targets" Condition="Exists('$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.targets')" />
</Project>